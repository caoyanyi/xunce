# Node.js >=24.8; the console accepts connections on all network interfaces.
# Set HOST=127.0.0.1 to limit access to this computer.
HOST=0.0.0.0
PORT=4318
# Docker Compose published port; the container keeps its internal port at 4318.
HTTP_PORT=4318
# Optional build mirrors. Debian packages keep their signature verification.
# DEBIAN_MIRROR=mirrors.aliyun.com
# NPM_REGISTRY=https://registry.npmjs.org
DATA_DIR=./data
# Optional existing Chromium executable; otherwise install with npm run browsers:install.
# CHROMIUM_PATH=/path/to/chrome

# Optional business-flow planner: OpenAI-compatible chat completions endpoint.
# PLANNER_BASE_URL=https://api.openai.com/v1
# PLANNER_MODEL=your-model
# PLANNER_API_KEY=

# Optional Midscene visual model. See https://midscenejs.com/model-common-config
# MIDSCENE_MODEL_BASE_URL=https://your-provider.example/v1
# MIDSCENE_MODEL_NAME=your-vision-model
# MIDSCENE_MODEL_FAMILY=your-supported-model-family
# MIDSCENE_MODEL_API_KEY=
