{
  "name": "e2e-explorer",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.8.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite\"",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build && npm run build:server",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "browsers:install": "playwright install chromium",
    "format": "prettier --write server shared web tests *.ts *.js *.json *.html README.md docs/plans/*.md .env.example --ignore-unknown",
    "build:server": "tsc -p tsconfig.server.json",
    "start:production": "node build/server/index.js",
    "test:docker": "node scripts/smoke-container.mjs"
  },
  "dependencies": {
    "@e2e-dev/web": "0.15.2",
    "@fastify/static": "^10.1.6",
    "@midscene/shared": "1.16.0",
    "@midscene/web": "1.16.0",
    "dotenv": "^18.0.8",
    "e2e": "0.21.2",
    "fastify": "^5.12.7",
    "lucide-react": "^1.60.0",
    "playwright": "1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "uuid": "^11.1.1",
    "sharp": "^0.35.5",
    "puppeteer-core": "^25.15.0"
  }
}
